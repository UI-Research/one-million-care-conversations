# No data in this repo (see README: no coalition data, no PII)
data/**
!data/**/
!data/**/.gitkeep
# the generated dictionary is schema only — no respondent data
!data/processed/data-dictionary.csv
# R
.Rproj.user/
.Rhistory
.RData
.Ruserdata
# Python
__pycache__/
.venv/
# Project documents live on Box, not in the repo
*.pdf
*.docx
# Rendered HTML is tracked (aggregates only); Quarto's intermediate folders are not
scripts/**/*_files/
# Browser-tool screenshots of rendered pages (embed data)
.playwright-mcp/
# OS
.DS_Store
# Box API token cache, in case one ever lands in the working tree
.boxr-oauth*
